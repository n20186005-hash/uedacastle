---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CTA from "../../components/CTA.astro";
const faqs = [
  ["上田城に天守はありますか？", "現在、見学できる天守はありません。上田城の主な見どころは、西櫓、南櫓・北櫓、東虎口櫓門、石垣、土塁、水堀、尼ヶ淵です。"],
  ["上田城跡公園は無料ですか？", "公園は24時間入園でき、無料です。上田市立博物館と南櫓・北櫓の内部見学は有料です。"],
  ["開園時間は何時ですか？", "城跡公園は24時間入れます。博物館と櫓は原則9:00から17:00、最終入館16:30です。休館日・冬季休館・臨時変更があります。"],
  ["見学には何分必要ですか？", "代表景観だけなら30分、尼ヶ淵と堀までなら60分、博物館と櫓内部を含めるなら約120分が目安です。"],
  ["西櫓の中へ入れますか？", "西櫓は内部非公開です。南櫓・北櫓は開館期に内部見学ができます。"],
  ["上田駅から歩けますか？", "上田駅お城口から徒歩約12分です。大きな荷物を預けてから向かうと、尼ヶ淵の階段や城下町散歩が楽になります。"],
  ["駐車場はありますか？", "北側駐車場と南側駐車場があります。北側は本丸へ高低差が少なく、南側は尼ヶ淵に近い一方で階段・坂があります。"],
  ["車椅子やベビーカーでも見学できますか？", "北側から二の丸・本丸へ進むルートは比較的穏やかです。尼ヶ淵への行き来には階段・坂があるため、上から見るルートを選べます。"],
  ["雨の日でも楽しめますか？", "博物館と南・北櫓の内部を中心にすれば楽しめます。ただし屋外移動は残るため、滑りにくい靴と雨具を用意してください。"],
  ["冬でも見学できますか？", "公園は見学できますが、南櫓・北櫓は例年11月中旬頃から翌3月まで冬季休館です。凍結時は尼ヶ淵の階段を避けます。"],
  ["上田城と真田幸村の関係は？", "真田信繁（後世に幸村として広く知られる）は、父・昌幸とともに1600年の第二次上田合戦に関わりました。ただし現在の主要な櫓は真田時代の建物ではありません。"],
  ["真田井戸の抜け穴は本当にありますか？", "城外へ通じる秘密通路があったという話は伝承です。確認された事実としてではなく、上田城に残る物語として紹介されています。"],
  ["桜の見頃はいつですか？", "年によって変わります。例年の暦より、直前の開花情報・天気・催事日の交通情報で判断してください。"],
  ["ペットを連れて歩けますか？", "公園利用の最新ルールや催事時の制限を現地表示で確認し、リード・排泄物処理・混雑への配慮を徹底してください。建物内部は入館条件が異なります。"],
  ["御城印や日本100名城スタンプはどこですか？", "頒布・設置場所、時間、休止日は変わる可能性があります。眞田神社、観光案内、博物館等の当日案内を確認してください。"],
];
const schema = { "@context":"https://schema.org", "@type":"FAQPage", mainEntity: faqs.map(([q,a]) => ({"@type":"Question", name:q, acceptedAnswer:{"@type":"Answer", text:a}})) };
---
<BaseLayout title="よくある質問" description="上田城の天守、料金、営業時間、所要時間、駐車場、冬季休館、車椅子、雨の日、真田幸村との関係などを回答。" schema={schema}>
  <PageHero eyebrow="FAQ" title="よくある質問" description="出発前に迷いやすいことを、建物・時間・交通・季節・伝承に分けてまとめました。" />
  <section class="section"><div class="narrow"><div class="faq">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div><p class="small muted" style="margin-top:1.5rem">営業時間・料金・交通・催事情報は変更されるため、出発前に公式発表をご確認ください。</p></div></section>
  <section class="section section-sm"><div class="container"><CTA title="疑問が解けたら、歩く順番へ。" text="見学時間と食事の希望から、自分向けの散策ルートを作れます。" href="/routes/#planner" label="ルートをつくる" /></div></section>
</BaseLayout>
